{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webcraft-studio",
  "main": "src/worker.ts",
  "compatibility_date": "2025-02-01",
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "webcraft-db",
      "database_id": "8e364e62-c0da-4bb7-bc45-e10269382f1b"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "webcraft-uploads"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "KV",
      "id": "webcraft-kv-store"
    }
  ]
}
