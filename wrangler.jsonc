{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webcraft",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "placement": {
    "mode": "smart"
  },
  "observability": {
    "enabled": true
  },
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crm_db",
      "database_id": "dbe78523-f6db-44df-8322-8f8e378ad577"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "webcraft-uploads"
    }
  ]
}
